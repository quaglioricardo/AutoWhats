# Chave da API da Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Conexão com o Postgres do Autowhats
DATABASE_URL=postgres://autowhats:SENHA@localhost:5432/autowhats

# Porta do servidor Express
PORT=3001

# Senha de acesso ao painel (usuário: admin). Deixe vazio só em desenvolvimento.
APP_PASSWORD=


# --- WhatsApp pela Evolution API (opcional) ---
# Endereço da sua Evolution API, sem barra no final
EVOLUTION_API_URL=
# API key global da Evolution (ou a da instância)
EVOLUTION_API_KEY=
# Nome da instância que a Isis vai usar
EVOLUTION_INSTANCE=
# v2 (padrão) ou v1
EVOLUTION_API_VERSION=v2
# Senha que você inventa e coloca no fim da URL do webhook (?token=...)
EVOLUTION_WEBHOOK_TOKEN=
